# Production image: one container with the ASP.NET Core backend serving the built React frontend.
# Built by .github/workflows/release.yml on a beta/release tag; locally: docker build --build-arg APP_VERSION=v... .

FROM node:26-alpine AS frontend
WORKDIR /src
COPY branding.json languages.json ./
COPY branding ./branding
COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN cd frontend && npm ci --no-fund --no-audit --ignore-scripts
COPY frontend ./frontend
RUN cd frontend && npm run build

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS backend
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props branding.json languages.json ./
COPY src/Companion.Api/Companion.Api.csproj ./src/Companion.Api/
COPY src/PlatinVault.Versioning/PlatinVault.Versioning.csproj ./src/PlatinVault.Versioning/
RUN dotnet restore src/Companion.Api/Companion.Api.csproj
COPY src/PlatinVault.Versioning ./src/PlatinVault.Versioning
COPY src/Companion.Api ./src/Companion.Api
RUN dotnet publish src/Companion.Api/Companion.Api.csproj -c Release -o /app --no-restore -p:UseAppHost=false

# Realtime bridge (Windows exe for the gaming PC), published for win-x64 from the Linux SDK image and shipped inside the
# server image: users download it from the settings (ready-to-run ZIP) and a running bridge updates itself from /api/bridge/exe.
# Self-contained / single-file / trimming come from the csproj; only the version is passed in (1.0.<n> from scripts/build-bridge.ps1
# or the release workflow). EnableWindowsTargeting lets the Linux SDK build the net10.0-windows target.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS bridge
ARG BRIDGE_VERSION=1.0.0
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props ./
COPY src/PlatinVault.Bridge/PlatinVault.Bridge.csproj ./src/PlatinVault.Bridge/
RUN dotnet restore src/PlatinVault.Bridge/PlatinVault.Bridge.csproj -r win-x64 -p:Version=${BRIDGE_VERSION} -p:EnableWindowsTargeting=true
# The bridge compiles SteamLocalStatsService.cs of the server project through a link, so the sources of both are needed;
# branding/ holds the app icon (platinvault.ico) the exe, its windows and the tray icon use
COPY src ./src
COPY branding ./branding
RUN dotnet publish src/PlatinVault.Bridge/PlatinVault.Bridge.csproj -c Release -r win-x64 --no-restore \
        -p:Version=${BRIDGE_VERSION} -p:EnableWindowsTargeting=true -o /bridge \
    && printf '%s' "$BRIDGE_VERSION" > /bridge/bridge-version.txt \
    && mkdir -p /bridge/package \
    && if [ -d src/PlatinVault.Bridge/package ]; then cp -r src/PlatinVault.Bridge/package/. /bridge/package/; fi

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
ARG APP_VERSION=v0.0.0
# Version of the tagged commit (line 1 of the repository's version.txt), its five-segment build id (line 2) and the channel. The app
# writes them for people as "v2026.11.12 (13.557 β)" for "beta", "v2026.11.12 (13.557-dev)" for "dev" (a Dev-Build: the user's own test
# image, ASPNETCORE_ENVIRONMENT stays Production) and "v2026.11.12 (13.557)" for "release" (VersionFormat.cs)
ARG APP_VERSION_DETAIL=
ARG APP_CHANNEL=release
WORKDIR /app
COPY --from=backend /app ./
COPY --from=frontend /src/frontend/dist ./wwwroot
COPY --from=bridge /bridge ./bridge
# The end-user handbook (German and English PDF, generated by scripts/build-konzept.ps1 and committed in docs/handbuch/<lang>/)
# always ships with the product: GET /api/docs/handbook serves it and the bridge download ZIP contains it. The wildcard makes the
# build fail when a language has no PDF, instead of shipping an image without handbook.
COPY docs/handbuch/de/*.pdf ./docs/handbuch/de/
COPY docs/handbuch/en/*.pdf ./docs/handbuch/en/
# The licence documents (LICENSE = the GNU AGPL v3 text PlatinVault is licensed under, THIRD-PARTY-NOTICES.md = the notices of the
# bundled open-source components, generated by scripts/build-notices.ps1) ship with every image: GET /api/docs/licenses serves them,
# the bridge download ZIP contains them. Both are named explicitly, so the build fails when one is missing.
COPY LICENSE THIRD-PARTY-NOTICES.md ./docs/
# The entrypoint starts as root only to give /data (a bind mount such as Unraid's appdata, owned by the host) to PUID/PGID,
# then drops to that user - the app itself never runs as root. CRs are stripped in case of a CRLF checkout.
COPY deploy/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN printf '%s\n%s' "$APP_VERSION" "${APP_VERSION_DETAIL:-$APP_VERSION}" > /app/version.txt \
    && sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.sh \
    && chmod 755 /usr/local/bin/docker-entrypoint.sh \
    && mkdir -p /data
ENV ASPNETCORE_ENVIRONMENT=Production \
    Companion__DataDir=/data \
    Companion__ReleaseChannel=${APP_CHANNEL} \
    PUID=99 \
    PGID=100
VOLUME /data
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

