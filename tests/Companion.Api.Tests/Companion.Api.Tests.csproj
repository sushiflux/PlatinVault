<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests of the API (xunit.v3 on Microsoft.Testing.Platform, see global.json). Run: dotnet test tests/Companion.Api.Tests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit1051 asks for TestContext cancellation tokens; these tests only use in-memory fakes that answer at once -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Companion.Api\Companion.Api.csproj" />
  </ItemGroup>
</Project>
