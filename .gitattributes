* text=auto

# Shell scripts run inside Linux containers - must keep LF even on a Windows checkout
*.sh text eol=lf
scripts/git-hooks/* text eol=lf

# PowerShell and batch files stay CRLF (Windows PowerShell 5.1; cmd labels/goto break with LF)
*.ps1 text eol=crlf
*.cmd text eol=crlf
src/PlatinVault.Bridge/package/* text eol=crlf
# The Linux bridge package (install.sh, readme) is unpacked on Linux: LF
src/PlatinVault.Bridge.Linux/package/* text eol=lf

*.png binary
*.ico binary
*.woff2 binary

