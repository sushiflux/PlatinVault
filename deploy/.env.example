# Optional settings for docker-compose.yml. Copy this file to ".env" (same folder) and change what you need.
# Nothing secret belongs here.

# Port of the PlatinVault web interface on this host
PLATINVAULT_PORT=5233

# User and group that own the "data" folder and run PlatinVault. Find yours with:  id
# Plain Linux: usually 1000/1000. Unraid: 99/100. NAS: the numbers of the user that owns your data folder.
PUID=1000
PGID=1000

# Timezone (used for log times and backup file names), e.g. Europe/Berlin
TZ=Etc/UTC
