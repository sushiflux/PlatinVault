# Optional settings for docker-compose.yml. Copy this file to ".env" (same folder) and change what you need.
# Nothing secret belongs here.

# Port of the PlatinVault web interface on this host
PLATINVAULT_PORT=5233

# User and group that own the "data" folder and run PlatinVault. Find yours with:  id
# Plain Linux: usually 1000/1000. Unraid: 99/100. NAS: the numbers of the user that owns your data folder.
PUID=1000
PGID=1000

# Timezone (used for log times and backup file names), e.g. Europe/Berlin
TZ=Etc/UTC

# Only for your own domain (reverse proxy). PlatinVault accepts IP addresses, localhost, names without a dot (e.g. tower) and
# names ending in .local, .lan, .home.arpa, .internal and .fritz.box (protection against DNS rebinding). Other names go here, several with ;
# and *.example.com for every name below example.com:
# PLATINVAULT_ALLOWED_HOSTS=pv.example.com
# Only when your proxy rewrites the Host header and sends no X-Forwarded-Host/-Proto: the address of the page for the live channel
# PLATINVAULT_ALLOWED_ORIGINS=https://pv.example.com
