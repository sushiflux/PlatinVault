<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Shared code of the Windows program (PlatinVault.Desktop) and its installer (PlatinVault.Setup): the designed window frame and
    controls (light/dark, German/English), our own message dialogs, the install layout (folders, registry entries, shortcuts,
    autostart) and the install/uninstall engine. No package references: plain .NET + Windows Forms.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PlatinVault.Windows</RootNamespace>
    <AssemblyName>PlatinVault.Windows.Common</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- No forms designer is used: positions and values are set in code -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlatinVault.Versioning\PlatinVault.Versioning.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PlatinVault.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app icon (trophy) in every size, for windows, the tray and the installer -->
    <EmbeddedResource Include="..\..\branding\platinvault.ico" LogicalName="platinvault.ico" Link="Resources\platinvault.ico" />
  </ItemGroup>
</Project>
