<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Reading the Steam client's own files on this computer, read only: where Steam is installed (SteamLocator), which game runs right
    now (IRunningGameSource), the achievement stats files, appinfo.vdf and the library folders. Shared by the server (Companion.Api, also
    hosted by the Windows program), the Windows bridge and the Linux bridge, so all of them read Steam the same way.
    Plain net10.0 without UI: Windows-only code (the registry) sits behind OperatingSystem.IsWindows(), Linux-only code (/proc,
    loginusers.vdf) behind OperatingSystem.IsLinux() or an explicit platform argument, so tests can run the Linux logic on Windows.
  -->
  <PropertyGroup>
    <RootNamespace>PlatinVault.SteamLocal</RootNamespace>
    <AssemblyName>PlatinVault.SteamLocal</AssemblyName>
    <AssemblyTitle>PlatinVault Steam Local</AssemblyTitle>
    <!-- The Linux bridge may be published trimmed / native AOT: the analyzers keep this library ready for it -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Symbols inside the dll: a single-file bridge would otherwise get a loose .pdb next to its exe -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Companion.Api.Tests" />
    <InternalsVisibleTo Include="PlatinVault.Windows.Tests" />
  </ItemGroup>
</Project>
