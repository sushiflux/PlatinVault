<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows app that runs on the gaming PC and pushes the locally unlocked Steam achievements to the PlatinVault
    server (POST /api/bridge/state). Self-contained single-file exe (WinForms: tray icon, setup and status windows,
    no console window), see scripts/build-bridge.ps1. It installs itself per user and updates itself from the server
    (Installer.cs, SelfUpdater.cs).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PlatinVault.Bridge</AssemblyName>
    <RootNamespace>PlatinVault.Bridge</RootNamespace>
    <Description>PlatinVault Bridge - sends locally unlocked Steam achievements to a PlatinVault server in real time.</Description>
    <ApplicationIcon>..\..\branding\platinvault.ico</ApplicationIcon>

    <!-- Settings for ApplicationConfiguration.Initialize(): sharp on high-DPI screens, Segoe UI, visual styles. -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Segoe UI, 9.5pt</ApplicationDefaultFont>

    <!--
      The bridge has its own version, independent of the app version: 1.0.<commits touching the bridge>. The build script
      passes it with -p:Version=...; a plain "dotnet build" gets this placeholder.
    -->
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!--
      File properties: the bridge's own version stays its assembly and file version (Program.GetVersion reads the assembly version for
      the self-update and the "Apps" entry), set here after Directory.Build.props so a build-wide PvFileVersion can never replace it.
      The product version (InformationalVersion) is the readable version of the PlatinVault build it ships with (PvProductVersion).
    -->
    <AssemblyTitle>PlatinVault Bridge</AssemblyTitle>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>

    <!-- Same runtime identifier for build and publish keeps the restore graph (and packages.lock.json) identical. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- WinForms is not trim-safe, so the exe is published untrimmed. JSON still goes through source-generated contexts. -->
    <PublishTrimmed>false</PublishTrimmed>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Protocol, configuration file, language, log and polling loops shared with the Linux bridge: the sources of PlatinVault.Bridge.Core are
      compiled into this assembly instead of being referenced as a second assembly. Reason: some antivirus heuristics classify the thin
      remainder (installer, registry entries, self-update) of a Windows exe built with a separate Core assembly as adware and quarantine the
      freshly built dll, while the same code in one assembly (as before the split) passes. Same code, one implementation.
    -->
    <Compile Include="..\PlatinVault.Bridge.Core\**\*.cs" Exclude="..\PlatinVault.Bridge.Core\obj\**;..\PlatinVault.Bridge.Core\bin\**" LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- Single source of truth for reading the local Steam files: the library the server uses too (reached through Core, listed for clarity). -->
    <ProjectReference Include="..\PlatinVault.SteamLocal\PlatinVault.SteamLocal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Windows-only parts of the bridge need ILogger<T> for the shared readers; a plain app does not import this namespace implicitly. -->
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app icon is also embedded as a resource: windows and the tray pick the right size from it at runtime. -->
    <EmbeddedResource Include="..\..\branding\platinvault.ico" LogicalName="platinvault.ico" Link="Resources\platinvault.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Template the server zips together with the exe (see scripts/build-bridge.ps1); not part of the compilation. -->
    <None Include="package\**" />
    <None Include="README.md" />
  </ItemGroup>
</Project>
