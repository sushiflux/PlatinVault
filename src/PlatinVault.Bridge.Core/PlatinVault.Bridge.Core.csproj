<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The operating-system-neutral part of the PlatinVault bridges: the protocol towards the server (state push, command poll, library push,
    self-update download), the configuration file, the language handling, the log, the polling loops and the text catalogue helpers.
    The Windows bridge (PlatinVault.Bridge, tray program) and the Linux bridge (PlatinVault.Bridge.Linux, headless service) both build on
    it, so the protocol exists exactly once. Everything platform specific (reading the local Steam files, starting a game, installing,
    updating the own binary) sits behind small interfaces: ILocalSteam, ISteamLauncher, ISelfUpdater.

    The bridges COMPILE these sources into their own assembly (Compile Include in their csproj) instead of referencing this project: some
    antivirus heuristics quarantine the freshly built Windows bridge assembly when the shared code is a second assembly. This project exists
    so the shared code can be built and checked on its own (dotnet build src/PlatinVault.Bridge.Core); it is not shipped.
  -->
  <PropertyGroup>
    <RootNamespace>PlatinVault.Bridge</RootNamespace>
    <AssemblyName>PlatinVault.Bridge.Core</AssemblyName>
    <AssemblyTitle>PlatinVault Bridge Core</AssemblyTitle>
    <DebugType>embedded</DebugType>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reading the local Steam files (Windows registry / Linux folders and process list), shared with the server. -->
    <ProjectReference Include="..\PlatinVault.SteamLocal\PlatinVault.SteamLocal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
</Project>
